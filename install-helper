#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_file="$script_dir/charger-profile"
target_dir=/usr/local/libexec/omarchy-charger-monitor
target_file="$target_dir/charger-profile"

/usr/bin/sudo /usr/bin/install -d -o root -g root -m 0755 "$target_dir"
/usr/bin/sudo /usr/bin/install -o root -g root -m 0755 "$source_file" "$target_file"

printf 'Installed root-owned charging-profile helper at %s\n' "$target_file"
